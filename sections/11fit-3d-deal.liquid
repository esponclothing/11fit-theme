{% schema %}
{
  "name": "Luxe Swipe Deal",
  "settings": [
    {
      "type": "header",
      "content": "✨ Typography Settings"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body Font",
      "default": "lato_n4"
    },
    {
      "type": "header",
      "content": "🎨 Global Aesthetics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "VIP EXCLUSIVES"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Unlock limited-time privileges"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main Text Color",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Luxury Accent (Text/Borders)",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "🌟 Animated Glow Effect"
    },
    {
      "type": "color",
      "id": "glow_color_1",
      "label": "Glow Color 1",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "glow_color_2",
      "label": "Glow Color 2",
      "default": "#9B7E20"
    },
    {
      "type": "header",
      "content": "🎛️ Image & Layout Settings"
    },
    {
      "type": "range",
      "id": "image_scale",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Product Image Scale",
      "default": 80
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Auto-Swipe Speed",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_luxury_border",
      "label": "Enable Luxury Border Frame",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "⏳ Urgency Settings"
    },
    {
      "type": "number",
      "id": "timer_hours",
      "label": "Countdown Hours",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "deal",
      "name": "Custom Deal Slide",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product (Optional Fallback)"
        },
        {
          "type": "header",
          "content": "Custom Overrides"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image",
          "info": "Upload an image to override the product image."
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link",
          "info": "Where should the image and button link to?"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Deal Title",
          "info": "Overrides the product title."
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Price (e.g. 999.00)",
          "info": "Overrides the product price."
        },
        {
          "type": "text",
          "id": "custom_compare",
          "label": "Custom Compare Price (e.g. 1499.00)",
          "info": "Leave blank if not on sale."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxe Swipe Deal (Pro)",
      "blocks": [
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" }
      ]
    }
  ]
}
{% endschema %}

{%- assign heading_font = section.settings.heading_font -%}
{%- assign body_font = section.settings.body_font -%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #luxe-wrapper-{{ section.id }} {
    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --color-bg: {{ section.settings.bg_color }};
    --color-text: {{ section.settings.text_color }};
    --color-accent: {{ section.settings.accent_color }};
    --glow-1: {{ section.settings.glow_color_1 }};
    --glow-2: {{ section.settings.glow_color_2 }};
    --image-scale: {{ section.settings.image_scale }}%;
    --padding-y: {{ section.settings.padding_vertical }}px;
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.08);
    
    background-color: var(--color-bg);
    padding: var(--padding-y) 20px;
    font-family: var(--font-body);
    overflow: hidden;
    color: var(--color-text);
    position: relative;
  }

  {% if section.settings.show_luxury_border %}
  #luxe-wrapper-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    bottom: 20px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 12px;
    pointer-events: none;
    z-index: 1;
  }
  {% endif %}

  .luxe-header {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
    z-index: 2;
  }

  .luxe-heading {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 400;
    margin: 0 0 10px 0;
    text-transform: uppercase;
    letter-spacing: 6px;
    background: linear-gradient(to right, var(--color-text), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .luxe-subheading {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
    margin: 0;
  }

  /* Glassmorphic Timer */
  .luxe-timer-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-bottom: 50px;
    position: relative;
    z-index: 2;
  }
  
  .luxe-timer-box {
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 15px 18px;
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: 26px;
    min-width: 70px;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    position: relative;
  }

  .luxe-timer-colon {
    font-weight: 300;
    font-size: 24px;
    color: var(--color-accent);
    animation: pulse-colon 2s infinite ease-in-out;
  }

  @keyframes pulse-colon {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .luxe-timer-label {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
    margin-top: 6px;
  }

  /* Slider Area with Animated Custom Glowing Orb */
  .luxe-slider-wrap {
    width: 100%;
    max-width: 450px;
    aspect-ratio: 1 / 1;
    position: relative;
    margin: 0 auto 30px auto;
    z-index: 2;
  }

  .luxe-slider-wrap::before {
    content: '';
    position: absolute;
    top: 5%; left: 5%; right: 5%; bottom: 5%;
    background: linear-gradient(45deg, var(--glow-1), var(--glow-2));
    opacity: 0.25;
    border-radius: 50%;
    filter: blur(40px);
    animation: luxeGlowAnimate 6s ease-in-out infinite alternate;
    z-index: -1;
  }

  @keyframes luxeGlowAnimate {
    0% { transform: scale(0.9) rotate(0deg); opacity: 0.15; }
    100% { transform: scale(1.1) rotate(15deg); opacity: 0.35; }
  }

  .luxe-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    position: relative;
  }
  .luxe-track::-webkit-scrollbar { display: none; }

  .luxe-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    box-sizing: border-box;
  }

  .luxe-slide-link {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .luxe-slide img {
    max-width: var(--image-scale);
    max-height: var(--image-scale);
    object-fit: contain;
    filter: drop-shadow(0px 30px 40px rgba(0,0,0,0.4));
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
  }
  
  .luxe-slide-link:hover img {
    transform: scale(1.08) translateY(-10px);
  }

  .luxe-placeholder-svg {
    width: var(--image-scale);
    height: var(--image-scale);
    fill: var(--color-text);
    opacity: 0.1;
  }

  /* Elegant Dots */
  .luxe-dots {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
    position: relative;
    z-index: 2;
  }
  .luxe-dot { 
    width: 8px; 
    height: 8px; 
    border-radius: 50%; 
    background: var(--glass-border); 
    border: 1px solid transparent;
    transition: all 0.4s ease; 
    cursor: pointer; 
  }
  .luxe-dot.is-active { 
    background: var(--color-accent); 
    box-shadow: 0 0 10px var(--color-accent);
    transform: scale(1.4);
  }

  /* Product Info */
  .luxe-text-area {
    text-align: center;
    max-width: 420px;
    margin: 40px auto 0;
    transition: opacity 0.4s ease;
    position: relative;
    z-index: 2;
  }

  .luxe-title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 400;
    margin: 0 0 15px 0;
    color: var(--color-text);
    letter-spacing: 1px;
  }

  /* Price Reveal */
  .luxe-price-row {
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    height: 45px;
  }

  .luxe-locked-text {
    font-size: 24px;
    color: color-mix(in srgb, var(--color-text) 30%, transparent);
    letter-spacing: 8px;
  }

  .luxe-unlocked-text {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 400;
    color: var(--color-accent);
    text-shadow: 0 0 20px color-mix(in srgb, var(--color-accent) 40%, transparent);
    animation: fadeUp 0.6s ease forwards;
  }

  .luxe-compare {
    font-size: 16px;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
    text-decoration: line-through;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .luxe-compare.is-visible { opacity: 1; }

  @keyframes fadeUp {
    0% { transform: translateY(15px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  /* High-Converting Lucrative Button */
  .luxe-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 360px;
    height: 60px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 3px;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }
  
  .luxe-btn-progress {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 0%;
    background: var(--color-accent);
    opacity: 0.3;
  }

  .luxe-btn.is-locked {
    background: var(--glass-bg);
    color: var(--color-text);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(5px);
  }

  .luxe-btn.is-unlocked {
    background: var(--glow-1);
    color: #000000;
    border: 1px solid var(--glow-1);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--glow-1) 30%, transparent);
  }

  .luxe-btn.is-unlocked:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px color-mix(in srgb, var(--glow-1) 50%, transparent);
    filter: brightness(1.1);
  }

  /* PC Layout Grid */
  @media (min-width: 900px) {
    #luxe-wrapper-{{ section.id }} {
      max-width: 1200px;
      margin: 40px auto;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      grid-template-areas: 
        "header slider"
        "timer slider"
        ". dots"
        ". textarea";
      align-items: center;
      gap: 20px 60px;
      padding: 100px 80px;
      border-radius: 24px;
      box-shadow: 0 40px 100px rgba(0,0,0,0.5);
    }
    .luxe-header { grid-area: header; text-align: left; margin-bottom: 0; align-self: end; }
    .luxe-timer-wrap { grid-area: timer; justify-content: flex-start; margin-bottom: 0; align-self: start; }
    .luxe-text-area { grid-area: textarea; text-align: center; margin: 0 auto; max-width: 450px; }
    .luxe-slider-wrap { grid-area: slider; margin: 0 auto; max-width: 600px; }
    .luxe-dots { grid-area: dots; margin-top: 0; }
  }
</style>

<div class="luxe-wrapper" id="luxe-wrapper-{{ section.id }}" data-speed="{{ section.settings.autoplay_speed | times: 1000 }}" data-timer="{{ section.settings.timer_hours }}">
  
  <div class="luxe-header">
    <h2 class="luxe-heading">{{ section.settings.heading }}</h2>
    <p class="luxe-subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="luxe-timer-wrap">
    <div class="luxe-timer-box">
      <span id="luxeHr-{{ section.id }}">00</span>
      <span class="luxe-timer-label">Hours</span>
    </div>
    <span class="luxe-timer-colon">:</span>
    <div class="luxe-timer-box">
      <span id="luxeMin-{{ section.id }}">00</span>
      <span class="luxe-timer-label">Mins</span>
    </div>
    <span class="luxe-timer-colon">:</span>
    <div class="luxe-timer-box">
      <span id="luxeSec-{{ section.id }}">00</span>
      <span class="luxe-timer-label">Secs</span>
    </div>
  </div>

  <div class="luxe-slider-wrap">
    <div class="luxe-track" id="luxeTrack-{{ section.id }}">
      {% for block in section.blocks %}
        
        {%- comment -%} Determine values: Fallback to Product if Custom is empty {%- endcomment -%}
        {% assign slide_product = block.settings.product %}
        
        {% assign slide_title = block.settings.custom_title | default: slide_product.title | default: 'VIP Exclusive Deal' %}
        {% assign slide_price = block.settings.custom_price | default: slide_product.price | money_without_trailing_zeros | default: '999.00' %}
        
        {% assign slide_compare = block.settings.custom_compare %}
        {% if slide_compare == blank and slide_product.compare_at_price > slide_product.price %}
            {% assign slide_compare = slide_product.compare_at_price | money_without_trailing_zeros %}
        {% endif %}

        {% assign slide_link = block.settings.custom_link | default: slide_product.url | default: '#' %}
        {% assign slide_image = block.settings.custom_image | default: slide_product.featured_image %}

        <div class="luxe-slide" 
             data-index="{{ forloop.index0 }}"
             data-title="{{ slide_title | escape }}"
             data-price="{{ slide_price }}"
             data-compare="{{ slide_compare }}"
             data-url="{{ slide_link }}"
             {{ block.shopify_attributes }}>
          
          <a href="{{ slide_link }}" class="luxe-slide-link" draggable="false">
            {% if slide_image != blank %}
              <img src="{{ slide_image | img_url: '800x800' }}" alt="{{ slide_title | escape }}" loading="lazy" draggable="false">
            {% else %}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'luxe-placeholder-svg' }}
            {% endif %}
          </a>
          
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="luxe-dots" id="luxeDots-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="luxe-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}"></div>
    {% endfor %}
  </div>

  <div class="luxe-text-area" id="luxeTextArea-{{ section.id }}">
    <h3 class="luxe-title" id="luxeTitle-{{ section.id }}">Loading...</h3>
    
    <div class="luxe-price-row">
      <span id="luxePrice-{{ section.id }}"><span class="luxe-locked-text">••••••</span></span>
      <span class="luxe-compare" id="luxeCompare-{{ section.id }}"></span>
    </div>

    <a href="#" class="luxe-btn is-unlocked" id="luxeBtn-{{ section.id }}">
      <span class="luxe-btn-progress" style="display:none;"></span>
      <span class="luxe-btn-text">View Deal</span>
    </a>
  </div>

</div>

<script>
(function() {
  function initLuxeDeal(wrapper) {
    if (wrapper.dataset.initialized === 'true') return;
    wrapper.dataset.initialized = 'true';

    const sectionId = wrapper.id.replace('luxe-wrapper-', '');
    const timerHours = parseInt(wrapper.getAttribute('data-timer')) || 12;
    const hrEl = document.getElementById('luxeHr-' + sectionId);
    const minEl = document.getElementById('luxeMin-' + sectionId);
    const secEl = document.getElementById('luxeSec-' + sectionId);
    
    let endTime;
    try {
      endTime = localStorage.getItem('luxe_timer_' + sectionId);
      if (!endTime || new Date().getTime() > endTime) {
        endTime = new Date().getTime() + (timerHours * 60 * 60 * 1000);
        localStorage.setItem('luxe_timer_' + sectionId, endTime);
      }
    } catch (e) {
      endTime = new Date().getTime() + (timerHours * 60 * 60 * 1000);
    }

    function updateTimer() {
      let now = new Date().getTime();
      let distance = endTime - now;
      if (distance < 0) {
        endTime = new Date().getTime() + (timerHours * 60 * 60 * 1000);
        distance = endTime - now;
      }
      let h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      let m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      let s = Math.floor((distance % (1000 * 60)) / 1000);
      
      if(hrEl) hrEl.innerText = (h < 10 ? '0' : '') + h;
      if(minEl) minEl.innerText = (m < 10 ? '0' : '') + m;
      if(secEl) secEl.innerText = (s < 10 ? '0' : '') + s;
    }
    updateTimer(); 
    setInterval(updateTimer, 1000);

    const track = document.getElementById('luxeTrack-' + sectionId);
    if (!track) return;
    const slides = Array.from(track.querySelectorAll('.luxe-slide'));
    const dots = document.querySelectorAll('#luxeDots-' + sectionId + ' .luxe-dot');
    const textArea = document.getElementById('luxeTextArea-' + sectionId);
    const titleEl = document.getElementById('luxeTitle-' + sectionId);
    const priceEl = document.getElementById('luxePrice-' + sectionId);
    const compareEl = document.getElementById('luxeCompare-' + sectionId);
    const btnEl = document.getElementById('luxeBtn-' + sectionId);
    
    const speed = parseInt(wrapper.getAttribute('data-speed')) || 4000;
    let currentIndex = 0;
    let autoPlayInterval = null;
    let swipeDirection = 1;
    let isPriceUnlocked = false; 
    let isHolding = false;
    let holdInterval = null;
    let holdTimeout = null;
    let holdPercent = 0;
    
    const btnProgress = btnEl.querySelector('.luxe-btn-progress');
    const btnText = btnEl.querySelector('.luxe-btn-text');

    function startHold(e) {
      if (isPriceUnlocked || isHolding) return;
      isHolding = true; holdPercent = 0;
      holdInterval = setInterval(() => {
        if (holdPercent < 100) { holdPercent += 5; if(btnProgress) btnProgress.style.width = holdPercent + '%'; }
      }, 50);
      holdTimeout = setTimeout(triggerUnlock, 1000);
    }

    function cancelHold() {
      if (isPriceUnlocked || !isHolding) return;
      isHolding = false; clearTimeout(holdTimeout); clearInterval(holdInterval);
      if (btnProgress) { btnProgress.style.width = '0%'; }
    }

    function triggerUnlock() {
      isHolding = false; clearTimeout(holdTimeout); clearInterval(holdInterval);
      isPriceUnlocked = true; stopAutoPlay();
      if (btnProgress) btnProgress.style.width = '100%';
      const activeSlide = slides[currentIndex];
      
      let priceTxt = activeSlide.getAttribute('data-price');
      if (!priceTxt.includes('Rs.') && !priceTxt.includes('$')) priceTxt = 'Rs. ' + priceTxt;
      
      priceEl.innerHTML = '<span class="luxe-unlocked-text">' + priceTxt + '</span>';
      
      const compVal = activeSlide.getAttribute('data-compare');
      if (compVal && compVal.trim() !== '') {
        let compTxt = compVal;
        if (!compTxt.includes('Rs.') && !compTxt.includes('$')) compTxt = 'Rs. ' + compTxt;
        compareEl.innerText = compTxt;
        compareEl.classList.add('is-visible');
      }

      setTimeout(() => {
        btnEl.classList.remove('is-locked');
        btnEl.classList.add('is-unlocked');
        if (btnText) btnText.innerText = 'Add To Bag';
        btnEl.href = activeSlide.getAttribute('data-url');
        if (btnProgress) btnProgress.style.display = 'none';
      }, 300);
    }

    btnEl.addEventListener('mousedown', startHold);
    btnEl.addEventListener('touchstart', startHold, {passive: true});
    window.addEventListener('mouseup', cancelHold);
    window.addEventListener('touchend', cancelHold);
    btnEl.addEventListener('mouseleave', cancelHold);
    btnEl.addEventListener('click', (e) => { if (!isPriceUnlocked) e.preventDefault(); });

    // Ensure links inside slider don't trigger click on drag
    let startX = 0, startY = 0;
    track.addEventListener('mousedown', (e) => { startX = e.clientX; startY = e.clientY; });
    track.addEventListener('click', (e) => {
      if (Math.abs(e.clientX - startX) > 5 || Math.abs(e.clientY - startY) > 5) e.preventDefault();
    });

    function updateTextForSlide(index) {
      if (!slides[index]) return;
      textArea.style.opacity = '0';
      
      setTimeout(() => {
        const activeSlide = slides[index];
        titleEl.innerText = activeSlide.getAttribute('data-title') || '';
        isPriceUnlocked = true;
        
        let priceTxt = activeSlide.getAttribute('data-price');
        if (!priceTxt.includes('Rs.') && !priceTxt.includes('$')) priceTxt = 'Rs. ' + priceTxt;
        priceEl.innerText = priceTxt;
        
        const compVal = activeSlide.getAttribute('data-compare');
        if (compVal && compVal.trim() !== '') {
          let compTxt = compVal;
          if (!compTxt.includes('Rs.') && !compTxt.includes('$')) compTxt = 'Rs. ' + compTxt;
          compareEl.innerText = compTxt;
          compareEl.classList.add('is-visible');
        } else {
          compareEl.classList.remove('is-visible');
        }
        
        btnEl.classList.remove('is-locked');
        btnEl.classList.add('is-unlocked');
        if (btnText) btnText.innerText = 'View Deal';
        if (btnProgress) btnProgress.style.display = 'none';
        btnEl.href = activeSlide.getAttribute('data-url');
        
        textArea.style.opacity = '1';
      }, 300);
    }

    const slideObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = slides.indexOf(entry.target);
          if (index !== -1 && index !== currentIndex) {
            currentIndex = index;
            dots.forEach(d => d.classList.remove('is-active'));
            if(dots[currentIndex]) dots[currentIndex].classList.add('is-active');
            updateTextForSlide(currentIndex);
          }
        }
      });
    }, { root: track, threshold: 0.5 });
    
    slides.forEach(slide => slideObserver.observe(slide));
    updateTextForSlide(0);

    function scrollToSlide(index) {
      if (!slides[index]) return;
      track.scrollTo({ left: slides[index].offsetLeft, behavior: 'smooth' });
    }

    function autoScroll() {
      if (slides.length <= 1) return;
      if (currentIndex >= slides.length - 1) swipeDirection = -1;
      else if (currentIndex <= 0) swipeDirection = 1;
      scrollToSlide(currentIndex + swipeDirection);
    }

    function startAutoPlay() { if (slides.length > 1) autoPlayInterval = setInterval(autoScroll, speed); }
    function stopAutoPlay() { clearInterval(autoPlayInterval); }

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        stopAutoPlay();
        scrollToSlide(parseInt(e.currentTarget.getAttribute('data-index')));
        if(!isPriceUnlocked) startAutoPlay();
      });
    });

    startAutoPlay();
  }

  function initAll() { document.querySelectorAll('.luxe-wrapper').forEach(initLuxeDeal); }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initAll); } else { initAll(); }
  if (window.Shopify && window.Shopify.designMode) {
    document.addEventListener('shopify:section:load', (e) => {
      const wrapper = e.target.querySelector('.luxe-wrapper');
      if (wrapper) initLuxeDeal(wrapper);
    });
  }
})();
</script>