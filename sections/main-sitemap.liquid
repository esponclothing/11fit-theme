
<div class="fit11-sitemap-section page-width" style="padding: 50px 20px; max-width: 1200px; margin: 0 auto; font-family: inherit;">
  <div style="text-align: center; margin-bottom: 45px;">
    <span style="background: #c5a059; color: #000; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; padding: 4px 14px; border-radius: 20px; box-shadow: 0 2px 4px rgba(197,160,89,0.2);">11FIT Directory & Sitemaps</span>
    <h1 style="font-size: 34px; font-weight: 900; color: #0f172a; margin: 15px 0 10px; letter-spacing: -0.5px;">11FIT HTML Sitemap & Complete Product Catalog</h1>
    <p style="color: #64748b; font-size: 15px; margin: 0; max-width: 650px; margin: 0 auto;">Discover all 11FIT activewear, gym workout shorts, oversized streetwear t-shirts, aesthetic baby tees, style guides, and customer support links.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px;">
    <!-- 1. All Products (Maximum Internal Link Authority) -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 25px; box-shadow: 0 4px 12px -2px rgba(0,0,0,0.03); grid-column: span 1 / span 2;">
      <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; border-bottom: 2px solid #c5a059; padding-bottom: 10px; margin-top: 0; display: flex; items-center; justify-content: space-between;">
        <span>👕 All Products & Activewear Items</span>
        <span style="font-size: 12px; font-weight: 600; color: #64748b;">Direct Links</span>
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px; margin-top: 15px;">
        {% for product in collections.all.products limit: 100 %}
          {% unless product.handle contains 'partial-payment' %}
            <div style="padding: 4px 0;">
              <a href="{{ product.url }}" style="color: #334155; text-decoration: none; font-size: 13px; font-weight: 500; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" onmouseover="this.style.color='#c5a059'" onmouseout="this.style.color='#334155'">
                • {{ product.title }}
              </a>
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>

    <!-- 2. Collections -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 25px; box-shadow: 0 4px 12px -2px rgba(0,0,0,0.03);">
      <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; border-bottom: 2px solid #c5a059; padding-bottom: 10px; margin-top: 0;">🛍️ Category Collections</h2>
      <ul style="list-style: none; padding: 0; margin: 15px 0 0; line-height: 2.2;">
        {% for collection in collections %}
          {% unless collection.handle == 'frontpage' or collection.handle == 'all' %}
            <li>
              <a href="{{ collection.url }}" style="color: #334155; text-decoration: none; font-weight: 600; font-size: 14px;" onmouseover="this.style.color='#c5a059'" onmouseout="this.style.color='#334155'">
                • {{ collection.title }} <span style="font-size: 11px; color: #94a3b8; font-weight: 400;">({{ collection.products_count }} items)</span>
              </a>
            </li>
          {% endunless %}
        {% endfor %}
      </ul>
    </div>

    <!-- 3. Style & Fitness Guides (All Articles) -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 25px; box-shadow: 0 4px 12px -2px rgba(0,0,0,0.03);">
      <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; border-bottom: 2px solid #c5a059; padding-bottom: 10px; margin-top: 0;">📖 Style & Fitness Journals</h2>
      <ul style="list-style: none; padding: 0; margin: 15px 0 0; line-height: 2;">
        {% for article in blogs.journal.articles %}
          <li>
            <a href="{{ article.url }}" style="color: #334155; text-decoration: none; font-size: 13px; font-weight: 500;" onmouseover="this.style.color='#c5a059'" onmouseout="this.style.color='#334155'">
              • {{ article.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <!-- 4. Customer Support & Policies -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 25px; box-shadow: 0 4px 12px -2px rgba(0,0,0,0.03);">
      <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; border-bottom: 2px solid #c5a059; padding-bottom: 10px; margin-top: 0;">ℹ️ Customer Service & Legal</h2>
      <ul style="list-style: none; padding: 0; margin: 15px 0 0; line-height: 2.2;">
        <li><a href="/pages/about-us" style="color: #334155; text-decoration: none; font-weight: 600; font-size: 14px;">• About 11FIT & Elevenfit Clothing</a></li>
        <li><a href="/pages/faq" style="color: #334155; text-decoration: none; font-weight: 600; font-size: 14px;">• Help & FAQs</a></li>
        <li><a href="/pages/size-guide" style="color: #334155; text-decoration: none; font-weight: 600; font-size: 14px;">• Comprehensive Size Guide</a></li>
        <li><a href="/pages/order-tracking" style="color: #334155; text-decoration: none; font-weight: 600; font-size: 14px;">• Track Order Status</a></li>
        <li><a href="/pages/contact" style="color: #334155; text-decoration: none; font-weight: 600; font-size: 14px;">• Contact Support</a></li>
        <li><a href="/policies/shipping-policy" style="color: #334155; text-decoration: none; font-weight: 500; font-size: 13px;">• Shipping Policy</a></li>
        <li><a href="/policies/refund-policy" style="color: #334155; text-decoration: none; font-weight: 500; font-size: 13px;">• 7-Day Return & Exchange Policy</a></li>
        <li><a href="/policies/terms-of-service" style="color: #334155; text-decoration: none; font-weight: 500; font-size: 13px;">• Terms of Service</a></li>
        <li><a href="/policies/privacy-policy" style="color: #334155; text-decoration: none; font-weight: 500; font-size: 13px;">• Privacy Policy</a></li>
        <li><a href="/pages/llms-txt" style="color: #c5a059; text-decoration: none; font-weight: 700; font-size: 13px;">• AI Model Index (llms.txt)</a></li>
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11FIT HTML Sitemap",
  "settings": []
}
{% endschema %}
