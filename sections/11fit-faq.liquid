
<div class="fit11-faq-section page-width" style="padding: 40px 0; max-width: 900px; margin: 0 auto;">
  <div style="text-align: center; margin-bottom: 30px;">
    <span style="background: #f1f5f9; color: #0f172a; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; padding: 4px 12px; border-radius: 20px;">Frequently Asked Questions</span>
    <h2 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 12px 0 6px;">{{ section.settings.heading | default: "Got Questions? We've Got Answers." }}</h2>
    <p style="color: #64748b; font-size: 14px; margin: 0;">Everything you need to know about 11FIT fabrics, sizing, shipping, and returns.</p>
  </div>

  <div class="fit11-faq-accordion" style="display: flex; flex-direction: column; gap: 12px;">
    {% for block in section.blocks %}
      <details class="fit11-faq-item" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px 20px; transition: border-color 0.2s;" {{ block.shopify_attributes }}>
        <summary style="font-weight: 700; font-size: 15px; color: #0f172a; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none;">
          <span>{{ block.settings.question }}</span>
          <span style="font-size: 18px; color: #c5a059; font-weight: 400; margin-left: 10px;">+</span>
        </summary>
        <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #f1f5f9; color: #475569; font-size: 14px; line-height: 1.6;">
          {{ block.settings.answer }}
        </div>
      </details>
    {% endfor %}
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for block in section.blocks %}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | json }}
      }
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>

<style>
  .fit11-faq-item[open] summary span:last-child {
    transform: rotate(45deg);
  }
  .fit11-faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>

{% schema %}
{
  "name": "11FIT SEO FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What makes 11FIT gym shorts and workout apparel different?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "11FIT apparel is engineered with 100% bio-washed combed cotton for streetwear tees & crop tops, and 4-way hyper-stretch quick-dry lycra for athletic shorts with secure zipper pockets."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "11FIT SEO FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Which are the best gym shorts for boys in India for heavy squats & running?",
            "answer": "11FIT offers the best 4-way stretch gym shorts for boys in India featuring quick-dry moisture wicking technology and deep dual zipper pockets to securely hold large smartphones during sprints."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Where can I buy trending aesthetic graphic crop tops and cute baby tees for girls online?",
            "answer": "11FIT (11fit.in) is India's top online destination for 100% bio-washed cotton graphic crop tops, retro 90s Y2K baby tees, and ribbed scoop neck tanks with Cash on Delivery (COD) across India."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How fast is express delivery for 11FIT orders across India?",
            "answer": "We provide express pan-India shipping delivering within 2 to 4 business days across Delhi NCR, Mumbai, Bengaluru, Hyderabad, Pune, Kolkata, and all other Indian cities."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the return and size exchange policy?",
            "answer": "11FIT offers a 7-day hassle-free return and size exchange policy. Size exchanges are 100% free of cost."
          }
        }
      ]
    }
  ]
}
{% endschema %}
