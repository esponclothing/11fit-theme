{% comment %}
  11FIT Comprehensive SEO & AI / GEO Structured Data Engine (JSON-LD)
  Engineered for Google Search, Google Gemini AI, ChatGPT Search, Meta AI & Perplexity
{% endcomment %}

<!-- 1. WebSite & Sitelinks Searchbox Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "11FIT",
  "alternateName": ["11FIT India", "11 Fit Clothing", "11FIT Streetwear & Activewear"],
  "url": "{{ shop.url }}",
  "description": "11FIT is India's leading youth streetwear and activewear brand offering 100% combed cotton aesthetic baby tees, graphic crop tops, workout shorts, trackpants, and oversized t-shirts.",
  "inLanguage": "en-IN",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

