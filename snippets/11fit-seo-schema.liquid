<!-- 7. Dynamic Article / BlogPosting Schema for Google Discover & AI Overviews -->
{% if request.page_type == 'article' and article %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ shop.url }}{{ article.url }}"
  },
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncatewords: 60 | json }},
  "image": [
    {% if article.image %}
      "https:{{ article.image | image_url: width: 1200 }}"
    {% else %}
      "https://cdn.shopify.com/s/files/1/1043/0526/2673/files/blk.jpg?v=1786008156"
    {% endif %}
  ],
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified": "{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "author": {
    "@type": "Organization",
    "name": "{{ article.author | default: '11FIT Editorial Team' }}",
    "url": "{{ shop.url }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "11FIT",
    "url": "{{ shop.url }}",
    "logo": {
      "@type": "ImageObject",
      "url": "https://11fit.in/cdn/shop/files/Untitled_500_x_500_px_1.png"
    }
  },
  "inLanguage": "en-IN",
  "keywords": {{ article.tags | join: ', ' | json }}
}
</script>
{% endif %}
