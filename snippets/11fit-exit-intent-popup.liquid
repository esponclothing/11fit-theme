{% comment %}
  11FIT Luxury Exit-Intent Recovery Modal
  Engineered for High-Converting Direct-to-Consumer Activewear
  Zero Cheap Emojis • Crisp Vector Typography • Minimalist Luxury Aesthetics
{% endcomment %}

<div id="fit11-exit-modal" class="fit11-modal-overlay" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="fit11-modal-backdrop" onclick="fit11CloseExitPopup()"></div>
  
  <div class="fit11-modal-container">
    <!-- Close Button -->
    <button type="button" class="fit11-close-btn" onclick="fit11CloseExitPopup()" aria-label="Close dialog">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Top Monogram & Eyebrow -->
    <div class="fit11-eyebrow-wrapper">
      <span class="fit11-brand-crest">11FIT</span>
      <span class="fit11-eyebrow-divider">|</span>
      <span class="fit11-eyebrow-text">SESSION COMPLIMENT</span>
    </div>

    <!-- Main Title -->
    <h2 class="fit11-modal-heading">
      Complimentary Express Shipping
    </h2>

    <p class="fit11-modal-subheading">
      Your checkout has been pre-authorized for complimentary priority courier dispatch to any address in India.
    </p>

    <!-- Shipping Privilege Highlight Card -->
    <div class="fit11-privilege-card">
      <div class="fit11-privilege-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div class="fit11-privilege-content">
        <div class="fit11-privilege-title">ZERO DELIVERY CHARGES APPLIED</div>
        <div class="fit11-privilege-note">Valid for both Cash on Delivery (COD) &amp; Prepaid Orders</div>
      </div>
    </div>

    <!-- 4 Architectural Feature Pillars (Clean 2x2 Grid) -->
    <div class="fit11-perks-grid">
      <div class="fit11-perk-item">
        <div class="fit11-perk-icon-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <div>
          <span class="fit11-perk-title">24-Hour Dispatch</span>
          <span class="fit11-perk-desc">Ships from Rohtak, Haryana</span>
        </div>
      </div>

      <div class="fit11-perk-item">
        <div class="fit11-perk-icon-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <span class="fit11-perk-title">Doorstep COD</span>
          <span class="fit11-perk-desc">Pay upon delivery</span>
        </div>
      </div>

      <div class="fit11-perk-item">
        <div class="fit11-perk-icon-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
        </div>
        <div>
          <span class="fit11-perk-title">7-Day Free Exchange</span>
          <span class="fit11-perk-desc">Hassle-free size replacement</span>
        </div>
      </div>

      <div class="fit11-perk-item">
        <div class="fit11-perk-icon-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <div>
          <span class="fit11-perk-title">Quality Assured</span>
          <span class="fit11-perk-desc">4-Way Lycra &amp; Cotton</span>
        </div>
      </div>
    </div>

    <!-- Primary Action Button -->
    <button type="button" class="fit11-primary-btn" onclick="fit11ClaimShipping()">
      <span>CLAIM FREE SHIPPING &amp; CONTINUE</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>

    <!-- Subtle Dismiss Link -->
    <button type="button" class="fit11-dismiss-btn" onclick="fit11CloseExitPopup()">
      Continue without priority delivery
    </button>
  </div>
</div>

<style>
  .fit11-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .fit11-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fit11Fade 0.25s ease-out forwards;
  }

  .fit11-modal-container {
    position: relative;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    max-width: 450px;
    width: 100%;
    padding: 36px 30px 26px;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.04);
    text-align: center;
    box-sizing: border-box;
    animation: fit11SlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .fit11-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #64748b;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .fit11-close-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #cbd5e1;
    transform: rotate(90deg);
  }

  .fit11-eyebrow-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    background: #fdfbf7;
    border: 1px solid rgba(197, 160, 89, 0.35);
    padding: 4px 14px;
    border-radius: 20px;
  }

  .fit11-brand-crest {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2px;
    color: #a88132;
    text-transform: uppercase;
  }

  .fit11-eyebrow-divider {
    color: rgba(197, 160, 89, 0.4);
    font-size: 10px;
  }

  .fit11-eyebrow-text {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #926d27;
    text-transform: uppercase;
  }

  .fit11-modal-heading {
    font-size: 24px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.4px;
    margin: 0 0 8px 0;
    line-height: 1.25;
  }

  .fit11-modal-subheading {
    font-size: 13.5px;
    line-height: 1.55;
    color: #64748b;
    margin: 0 0 20px 0;
  }

  .fit11-privilege-card {
    background: #faf7f0;
    border: 1px solid #ebd9b5;
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    text-align: left;
    margin-bottom: 22px;
    box-shadow: 0 2px 6px rgba(197, 160, 89, 0.06);
  }

  .fit11-privilege-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: #ffffff;
    border: 1px solid rgba(197, 160, 89, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
  }

  .fit11-privilege-title {
    font-size: 12.5px;
    font-weight: 800;
    color: #926d27;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .fit11-privilege-note {
    font-size: 12px;
    color: #475569;
    margin-top: 2px;
    line-height: 1.35;
  }

  .fit11-perks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 14px;
    text-align: left;
    margin-bottom: 24px;
    padding: 16px 0;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
  }

  .fit11-perk-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .fit11-perk-icon-box {
    margin-top: 1px;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fit11-perk-title {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
  }

  .fit11-perk-desc {
    display: block;
    font-size: 11px;
    color: #64748b;
    margin-top: 2px;
    line-height: 1.2;
  }

  .fit11-primary-btn {
    width: 100%;
    background: #0f172a;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border: none;
    border-radius: 10px;
    padding: 16px 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fit11-primary-btn:hover {
    background: #1e293b;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.26);
  }

  .fit11-primary-btn:active {
    transform: translateY(0);
  }

  .fit11-primary-btn svg {
    color: #c5a059;
  }

  .fit11-dismiss-btn {
    display: inline-block;
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 12px;
    margin-top: 14px;
    cursor: pointer;
    transition: color 0.15s;
    letter-spacing: 0.2px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fit11-dismiss-btn:hover {
    color: #475569;
  }

  @keyframes fit11Fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fit11SlideUp {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 480px) {
    .fit11-modal-container {
      padding: 28px 18px 20px;
      border-radius: 16px;
    }
    .fit11-modal-heading {
      font-size: 20px;
    }
    .fit11-perks-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>

<script>
(function() {
  var STORAGE_KEY = 'fit11_exit_shipping_session_shown';

  function hasShownRecently() {
    try {
      // Use sessionStorage so user can test easily per browser session
      return sessionStorage.getItem(STORAGE_KEY) === 'true';
    } catch(e) {
      return false;
    }
  }

  function markAsShown() {
    try {
      sessionStorage.setItem(STORAGE_KEY, 'true');
    } catch(e) {}
  }

  function showExitPopup() {
    if (hasShownRecently()) return;
    var modal = document.getElementById('fit11-exit-modal');
    if (!modal) return;
    modal.style.display = 'flex';
    modal.setAttribute('aria-hidden', 'false');
    markAsShown();
  }

  window.fit11CloseExitPopup = function() {
    var modal = document.getElementById('fit11-exit-modal');
    if (modal) {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }
  };

  window.fit11ClaimShipping = function() {
    fit11CloseExitPopup();
    var buyBtn = document.querySelector('.product-form__buttons button[type="submit"], #wa-checkout-trigger, .fit11-sticky-btn, button[name="add"], .fit11-buy-btn');
    if (buyBtn) {
      buyBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      buyBtn.style.transition = 'transform 0.3s, box-shadow 0.3s';
      buyBtn.style.transform = 'scale(1.05)';
      buyBtn.style.boxShadow = '0 0 20px #c5a059';
      setTimeout(function() {
        buyBtn.style.transform = 'scale(1)';
        buyBtn.style.boxShadow = '';
      }, 1000);
    } else {
      window.location.href = '/products/11-fit-air-flex-4-way-lycra-active-shorts';
    }
  };

  // Expose global manual trigger for instant testing
  window.showFit11ExitPopup = showExitPopup;

  // 1. Desktop: Mouse leave top of viewport
  document.addEventListener('mouseleave', function(e) {
    if (e.clientY <= 15) {
      showExitPopup();
    }
  });

  // 2. Mobile: Hardware/Browser Back Button Trap
  try {
    if (window.history && window.history.pushState) {
      window.history.pushState({ fit11ExitIntent: true }, '', window.location.href);
      window.addEventListener('popstate', function(e) {
        if (!hasShownRecently()) {
          showExitPopup();
        }
      });
    }
  } catch(e) {}

  // 3. Mobile: Accumulated Natural Scroll-Up Detection
  var maxScroll = 0;
  var lastScrollTop = 0;
  var upScrollAccumulator = 0;

  window.addEventListener('scroll', function() {
    var currentScroll = window.pageYOffset || document.documentElement.scrollTop;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight <= 0) return;
    var scrollPct = (currentScroll / docHeight) * 100;
    
    if (scrollPct > maxScroll) {
      maxScroll = scrollPct;
    }
    
    // User is scrolling UP after reaching at least 20% of page
    if (currentScroll < lastScrollTop) {
      upScrollAccumulator += (lastScrollTop - currentScroll);
      if (maxScroll > 20 && upScrollAccumulator > 60) {
        showExitPopup();
      }
    } else {
      upScrollAccumulator = 0;
    }
    lastScrollTop = currentScroll;
  }, { passive: true });

  // 4. Mobile: When user switches tabs or taps address bar
  document.addEventListener('visibilitychange', function() {
    if (document.visibilityState === 'hidden') {
      showExitPopup();
    }
  });

  // 5. Mobile & Desktop Fallback Timer: Show after 18 seconds of browsing
  setTimeout(function() {
    showExitPopup();
  }, 18000);

})();
</script>