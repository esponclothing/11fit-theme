{% comment %}
  ==============================================================================
  TINKAL X ESPONSPORTS - KWIKPASS-STYLE OTP LOGIN & ACCOUNT PORTAL SNIPPET
  ==============================================================================
  Render this snippet in theme header or account link:
     {% render 'tinkal-x-esponsports-login' %}
{% endcomment %}

{% assign MERCHANT_KEY = 'sk_live_11fit_106b31bb8dd7a7' %}
{% assign LOGIN_PORTAL_URL = 'https://checkout-app-one-lilac.vercel.app/account' %}

<!-- Customer Login Modal / Drawer Trigger Button -->
<button 
  id="tx-login-trigger" 
  class="tx-login-btn" 
  aria-label="Login with OTP / Account"
  onclick="openTxAccountModal()"
  type="button"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
    <circle cx="12" cy="7" r="4"></circle>
  </svg>
  <span class="tx-login-btn-text">Login / Orders</span>
</button>

<!-- Slide-over Modal -->
<div id="tx-login-modal-overlay" class="tx-modal-overlay" style="display: none;">
  <div class="tx-modal-content">
    <div class="tx-modal-header">
      <div class="tx-modal-brand">
        <span class="tx-modal-title">My Account & Orders</span>
        <span class="tx-modal-subtitle">OTP Powered Login</span>
      </div>
      <button class="tx-modal-close" onclick="closeTxAccountModal()" type="button">&times;</button>
    </div>
    <div class="tx-modal-body">
      <iframe 
        id="tx-account-iframe" 
        src="about:blank" 
        allow="clipboard-read; clipboard-write" 
        frameborder="0">
      </iframe>
    </div>
  </div>
</div>

<style>
  .tx-login-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: #111827;
    color: #ffffff;
    border: 1px solid #374151;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-left: 8px;
  }
  .tx-login-btn:hover {
    background: #1f2937;
    border-color: #ef4444;
  }
  .tx-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    z-index: 999999;
    display: flex;
    justify-content: flex-end;
  }
  .tx-modal-content {
    width: 100%;
    max-width: 480px;
    height: 100%;
    background: #020617;
    display: flex;
    flex-direction: column;
    box-shadow: -10px 0 30px rgba(0,0,0,0.5);
    animation: txSlideIn 0.3s ease-out;
  }
  @keyframes txSlideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  .tx-modal-header {
    padding: 16px 24px;
    border-bottom: 1px solid #1e293b;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tx-modal-title {
    font-weight: 700;
    color: #f8fafc;
    font-size: 16px;
    display: block;
  }
  .tx-modal-subtitle {
    font-size: 11px;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tx-modal-close {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
  }
  .tx-modal-close:hover {
    color: #ffffff;
  }
  .tx-modal-body {
    flex: 1;
    overflow: hidden;
  }
  #tx-account-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>

<script>
  function openTxAccountModal() {
    var overlay = document.getElementById('tx-login-modal-overlay');
    var iframe = document.getElementById('tx-account-iframe');
    if (overlay && iframe) {
      overlay.style.display = 'flex';
      if (iframe.src === 'about:blank' || !iframe.src) {
        var portalUrl = '{{ LOGIN_PORTAL_URL }}?merchant_key={{ MERCHANT_KEY }}&store={{ shop.domain }}';
        iframe.src = portalUrl;
      }
    }
  }

  function closeTxAccountModal() {
    var overlay = document.getElementById('tx-login-modal-overlay');
    if (overlay) {
      overlay.style.display = 'none';
    }
  }
</script>
